# Copy to .env and fill in. Never commit .env.

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile).
# The site key is public and baked in at build time; the secret is server-only.
# For local testing, Cloudflare's always-pass test keys are:
#   site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Signs the form's timestamp (minimum time-to-submit check).
# Generate with: openssl rand -base64 32
FORM_SIGNING_SECRET=

# resend (default, works on Node and Workers) | smtp (Node only) | log (dev/test)
MAIL_PROVIDER=resend

# Resend HTTP API (https://resend.com/api-keys). A "Sending access" key is enough.
# TODO(kyle): verify devnel.com in Resend. MAIL_FROM must be on a verified domain.
RESEND_API_KEY=

MAIL_FROM=contact@devnel.com
MAIL_FROM_NAME=devNel contact form
CONTACT_TO=kyle@devnel.com

# SMTP via Nodemailer (MAIL_PROVIDER=smtp, Node only)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# MAIL_PROVIDER=log appends messages to this file instead of sending (Node only)
MAIL_LOG_FILE=

# Which header holds the visitor's IP, for rate limiting. Only that header is
# trusted. none (direct, or the Cloudflare adapter) | x-forwarded-for (Caddy,
# Nginx) | x-real-ip (Nginx) | cf-connecting-ip (Node behind Cloudflare's proxy)
CLIENT_IP_HEADER=none

# Extra origins allowed to post the form, comma-separated (e.g. a staging
# domain). https://devnel.com and https://www.devnel.com are always allowed.
ALLOWED_ORIGINS=
