{
  "name": "devnel-com",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "devnel.com: portfolio and CV site for Kyle Nel",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:node": "ASTRO_ADAPTER=node astro build",
    "preview": "astro preview",
    "deploy": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false astro build && node scripts/check-deploy.mjs && wrangler deploy",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "resume:check": "node scripts/check-resume-privacy.mjs && node scripts/validate-resume.mjs",
    "contrast": "node scripts/contrast.mjs",
    "cv:pdf": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/cv-pdf.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/node": "^11.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/quando": "^5.3.0",
    "astro": "^7.3.8",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@jsonresume/schema": "^1.3.1",
    "@playwright/test": "^1.64.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/nodemailer": "^8.0.2",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "satori": "^0.55.1",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  }
}
