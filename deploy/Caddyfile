# devnel.com on Linux with Caddy. See README → Deploying.
#
# Caddy serves the static build (dist/client) itself and proxies only /api/*
# to the Astro Node server (npm start on 127.0.0.1:4321). The app's .env must
# set CLIENT_IP_HEADER=x-forwarded-for so rate limiting sees real visitors.

www.devnel.com {
	redir https://devnel.com{uri} permanent
}

devnel.com {
	root * /srv/devnel-com/dist/client
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "DENY"
		# The page CSP is a <meta> tag (see astro.config.mjs); frame-ancestors
		# only works as a header.
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# The contact endpoint: the only dynamic route.
	handle /api/* {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:4321
	}

	# Cloudflare/Netlify config, not content.
	handle /_headers {
		respond 404
	}

	handle {
		# Hashed build assets never change.
		header /_astro/* Cache-Control "public, max-age=31536000, immutable"
		# A small developer touch: the CV as JSON Resume, readable from anywhere.
		header /resume.json {
			Access-Control-Allow-Origin "*"
			Cache-Control "public, max-age=3600"
		}
		@html path / *.html */
		header @html Cache-Control "public, max-age=0, must-revalidate"

		# Pages are built as /about/index.html. trailingSlash is 'always', so
		# /about redirects to /about/.
		@noslash {
			not path */ *.*
			file {path}/index.html
		}
		redir @noslash {path}/ permanent

		try_files {path} {path}/index.html
		file_server
	}

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
