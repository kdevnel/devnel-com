---
/**
 * A small, accessible architecture diagram drawn as inline SVG.
 * Styles live in src/styles/diagram.css, imported by the case-study page:
 * CSS from components rendered inside MDX isn't covered by Astro's CSP hashes.
 * Nodes sit on a grid (col/row); edges are straight arrows between box edges.
 * No screenshots: this shows how the pieces connect, not internal tools.
 */
interface Node {
  id: string;
  label: string;
  sub?: string;
  col: number;
  row: number;
  /** Draw this node as the thing that was built. */
  primary?: boolean;
}

interface Edge {
  from: string;
  to: string;
  label?: string;
  /** Arrowheads at both ends. */
  both?: boolean;
}

interface Props {
  title: string;
  /** Plain-language description of the diagram, for screen readers and the caption. */
  description: string;
  nodes: Node[];
  edges: Edge[];
}

const { title, description, nodes, edges } = Astro.props;

const BOX_W = 190;
const BOX_H = 72;
const GAP_X = 84;
const GAP_Y = 64;
const PAD = 8;

const cols = Math.max(...nodes.map((n) => n.col)) + 1;
const rows = Math.max(...nodes.map((n) => n.row)) + 1;
const width = cols * BOX_W + (cols - 1) * GAP_X + PAD * 2;
const height = rows * BOX_H + (rows - 1) * GAP_Y + PAD * 2;

const pos = new Map(
  nodes.map((n) => [n.id, { x: PAD + n.col * (BOX_W + GAP_X), y: PAD + n.row * (BOX_H + GAP_Y) }]),
);

/** Where the line from a box's centre towards (tx, ty) leaves the box. */
function exitPoint(id: string, tx: number, ty: number, inset = 0) {
  const p = pos.get(id);
  if (!p) throw new Error(`ArchDiagram: unknown node "${id}"`);
  const cx = p.x + BOX_W / 2;
  const cy = p.y + BOX_H / 2;
  const dx = tx - cx;
  const dy = ty - cy;
  const scale = 1 / Math.max(Math.abs(dx) / (BOX_W / 2), Math.abs(dy) / (BOX_H / 2));
  const len = Math.hypot(dx, dy);
  return {
    x: cx + dx * scale + (dx / len) * inset,
    y: cy + dy * scale + (dy / len) * inset,
  };
}

const centre = (id: string) => {
  const p = pos.get(id)!;
  return { x: p.x + BOX_W / 2, y: p.y + BOX_H / 2 };
};

const lines = edges.map((e) => {
  const a = centre(e.from);
  const b = centre(e.to);
  const start = exitPoint(e.from, b.x, b.y, 4);
  const end = exitPoint(e.to, a.x, a.y, 6);
  return { ...e, x1: start.x, y1: start.y, x2: end.x, y2: end.y };
});

const uid = title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<figure class="diagram">
  <div class="diagram__scroll" tabindex="0" aria-label={`${title} (scrollable)`}>
    <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${uid}-t ${uid}-d`}>
      <title id={`${uid}-t`}>{title}</title>
      <desc id={`${uid}-d`}>{description}</desc>
      <defs>
        <marker
          id={`${uid}-arrow`}
          viewBox="0 0 10 10"
          refX="8"
          refY="5"
          markerWidth="7"
          markerHeight="7"
          orient="auto-start-reverse"
        >
          <path d="M0 0 10 5 0 10z" class="diagram__head"></path>
        </marker>
      </defs>
      <g class="diagram__edges">
        {lines.map((l) => (
          <g>
            <line
              x1={l.x1}
              y1={l.y1}
              x2={l.x2}
              y2={l.y2}
              marker-end={`url(#${uid}-arrow)`}
              marker-start={l.both ? `url(#${uid}-arrow)` : undefined}
            />
            {l.label && (
              <text x={(l.x1 + l.x2) / 2} y={(l.y1 + l.y2) / 2} class="diagram__edge-label" dy="-6">
                {l.label}
              </text>
            )}
          </g>
        ))}
      </g>
      {nodes.map((n) => {
        const p = pos.get(n.id)!;
        return (
          <g class:list={['diagram__node', { 'diagram__node--primary': n.primary }]}>
            <rect x={p.x} y={p.y} width={BOX_W} height={BOX_H} rx="4" />
            <text x={p.x + BOX_W / 2} y={p.y + (n.sub ? 31 : 42)} class="diagram__label">
              {n.label}
            </text>
            {n.sub && (
              <text x={p.x + BOX_W / 2} y={p.y + 53} class="diagram__sub">
                {n.sub}
              </text>
            )}
          </g>
        );
      })}
    </svg>
  </div>
  <figcaption>{description}</figcaption>
</figure>
