---
/**
 * devNel logo: the Quando wordmark plus the [>·<] mark, drawn from the
 * original outlined artwork (symbols in BrandSprite.astro) with the old
 * <wordpress specialist> subtitle removed. Colours come from CSS tokens
 * (--logo-word, --logo-mark), so it works on light and dark sections.
 * The subtitle is live text so it can change without redrawing the artwork.
 */
interface Props {
  subtitle?: boolean;
  class?: string;
}

const { subtitle = true, class: className } = Astro.props;

// TODO(kyle): confirm tagline. Alternative: "web engineer & support lead".
const TAGLINE = 'full-stack engineer';
---

<span class:list={['logo', className]}>
  <svg class="logo__art" viewBox="4 4 994 182" role="img" aria-label="devNel">
    <use class="logo__word" href="#devnel-word" width="1000" height="286"></use>
    <g class="logo__mark">
      <use href="#devnel-mark" x="776.5" y="6.2" width="219.4" height="111.8"></use>
    </g>
  </svg>
  {subtitle && <span class="logo__subtitle">&lt;{TAGLINE}&gt;</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    gap: 0.35em;
    line-height: 1;
  }

  .logo__art {
    width: var(--logo-width, 9rem);
    height: auto;
    overflow: visible; /* the mark sits on the top edge; don't clip the wiggle */
  }

  .logo__word {
    fill: var(--logo-word);
  }

  .logo__mark {
    fill: var(--logo-mark);
    transform-box: fill-box;
    transform-origin: center;
  }

  .logo__subtitle {
    font-family: var(--font-display);
    font-size: calc(var(--logo-width, 9rem) * 0.085);
    color: var(--logo-word);
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  /* The "straighten the bowtie" wiggle on hover (keyframes in global.css). */
  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) > .logo .logo__mark,
    .logo:hover .logo__mark {
      animation: var(--wiggle);
    }
  }
</style>
